<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from nuget.org, whatever feeds the machine has configured. A private feed the builder cannot reach breaks restore with a 401. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
